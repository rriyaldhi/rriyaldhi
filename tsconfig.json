{
  "compilerOptions": {
    "outDir": "./dist/",
    "rootDir": "./src",
    "sourceMap": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es6",
    "jsx": "react-jsx",
    "types": ["jest"],
    "esModuleInterop": true,
    "experimentalDecorators": true
  }
}
